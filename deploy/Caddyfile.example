# Canonical single-node reverse-proxy template for this repo.
# See: docs/reverse-proxy-caddy.md
#
# Expected environment:
#   PUBLIC_DOMAIN=travel.example.com
#   TLS_ACME_EMAIL=ops@example.com
#
# TLS termination occurs at Caddy.
# Uvicorn stays loopback-only on 127.0.0.1:8000.

{
	email {$TLS_ACME_EMAIL}
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	# Canonical security headers (S3 baseline).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		-Server
	}

	# Admin/debug endpoints must never be publicly reachable.
	# Allow only private/trusted source ranges to attempt app-level admin auth.
	@debug_public {
		path /debug/*
		not remote_ip private_ranges
	}
	respond @debug_public 403

	# Keep diagnostic-heavy/internal surfaces off the public internet by default.
	@diagnostic_public {
		path /health/deep /health/keys /metrics /llm/options /docs /redoc /openapi.json
		not remote_ip private_ranges
	}
	respond @diagnostic_public 403

	reverse_proxy 127.0.0.1:8000

	log {
		output file /var/log/caddy/llm-travel-agent-access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 336h
		}
		format json
	}
}
