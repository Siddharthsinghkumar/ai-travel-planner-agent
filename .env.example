# Backend runtime environment example (no secrets)
# Copy this to `.env` for local backend runtime configuration.
# For canonical production topology + env/secrets ownership, read:
# - docs/deployment-topology.md
# - docs/environment-secrets-contract.md

# ----------------------------
# Routing and providers
# ----------------------------
# Allowed: ollama_only | cloud_only | cloud_first | ollama_first
LLM_MODE=ollama_first

# Administrative gate:
# 0 = cloud disabled even if keys exist
# 1 = cloud allowed (actual usability still depends on provider keys)
USE_CLOUD_LLM=1

# Provider preference
CLOUD_PROVIDER_CHAIN=gemini,openai
CLOUD_PROVIDER=gemini

# ----------------------------
# Ollama runtime
# ----------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=30
OLLAMA_NUM_CTX=4096
OLLAMA_THINKING_MODE=disable

# ----------------------------
# Cloud runtime tuning
# ----------------------------
CLOUD_LLM_MODEL=gpt-4o-mini
CLOUD_LLM_TIMEOUT=60
CLOUD_LLM_STREAM_CHUNK_TIMEOUT=5

# ----------------------------
# App/runtime infra
# ----------------------------
# CORS allowlist (comma-separated). Set explicitly in production.
# Format: scheme://host[:port] entries only.
# Wildcard "*" is intentionally not accepted by runtime CORS parsing.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

PLANNER_PREWARM=0
ROUTER_TIMEOUT=90
PLANNER_LLM_TIMEOUT=45
PLANNER_STREAM_INIT_TIMEOUT=20
KEY_ENV_MONITOR_TICK=60
# Secret. Set a long random value in protected env injection for production.
ADMIN_TOKEN=
LOG_LEVEL=INFO

# Non-canonical runtime/debug toggles are intentionally omitted from this example.
# See CONFIG.md and docs/environment-secrets-contract.md for diagnostic/test-only flags.

# ----------------------------
# Data/tooling
# ----------------------------
# Production should use a persistent path (example: sqlite:////var/lib/llm-travel-agent/local.db)
DATABASE_URL=sqlite:///./local.db
WEATHER_FORECAST_MAX_DAYS=5

# Numbered key pools (canonical modern key surface, secrets)
# Inject real values from protected env/secret management; never commit them.
OPENAI_KEY_1=
GEMINI_KEY_1=
SERPAPI_KEY_1=
WEATHER_KEY_1=

# Booking path is SerpApi-first only.
# Do not set paid provider API vars (Duffel/Amadeus); they are out of scope.

# Legacy/deprecated vars are intentionally omitted from this canonical example.
# See CONFIG.md for migration notes.
